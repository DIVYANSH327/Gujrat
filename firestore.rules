rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role is string && data.role.size() <= 64;
    }

    function isValidChallan(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.vehicleNumber is string && data.vehicleNumber.size() <= 32 &&
             data.violationType is string && data.violationType.size() <= 64 &&
             data.status is string && data.status.size() <= 32;
    }

    function isValidAlert(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.alertType is string && data.alertType.size() <= 64 &&
             data.severity is string && data.severity.size() <= 32 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidEvidence(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.cameraId is string && data.cameraId.size() <= 64 &&
             data.plateNumber is string && data.plateNumber.size() <= 32 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    // User / Officer Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Challans
    match /challans/{challanId} {
      allow get: if isSignedIn() && isValidId(challanId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(challanId) && isValidChallan(request.resource.data);
      allow update: if isSignedIn() && isValidId(challanId) && isValidChallan(request.resource.data);
      allow delete: if isSignedIn() && isValidId(challanId);
    }

    // Intelligence Alerts
    match /alerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(alertId) && isValidAlert(request.resource.data);
      allow update: if isSignedIn() && isValidId(alertId) && isValidAlert(request.resource.data);
      allow delete: if isSignedIn() && isValidId(alertId);
    }

    // Vehicle Evidence Records
    match /evidence/{evidenceId} {
      allow get: if isSignedIn() && isValidId(evidenceId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(evidenceId) && isValidEvidence(request.resource.data);
      allow update: if isSignedIn() && isValidId(evidenceId) && isValidEvidence(request.resource.data);
      allow delete: if isSignedIn() && isValidId(evidenceId);
    }
  }
}
