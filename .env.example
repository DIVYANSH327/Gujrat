# ==============================================================================
# Gujarat Police CCTV & AI Intelligence Platform (SCRB) - Environment Config
# ==============================================================================
# All variables in this file are OPTIONAL. The platform boots and runs in local 
# Sentinel CCTV mode with self-recovery even if no AI credentials are provided.

# Google Gemini API Key (Optional)
# Enables Gemini 2.5/Flash multimodal vision inference for vehicle & HSRP detection.
# If omitted or invalid, the platform gracefully marks Gemini as UNAVAILABLE and
# continues camera acquisition and local OCR without crashing.
GEMINI_API_KEY=

# OmniRoute AI Provider Configuration (Optional)
# Used when routing vision inference through an OmniRoute gateway (local or tunnel).
OMNIROUTE_ENABLED=
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Google Maps Platform (Client-side)
# Used for real GIS map rendering, AdvancedMarkerElement, and camera corridor visualization.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Gujarat Police Sentinel CCTV Gateway Configuration (Optional)
CORP8_EMAIL=
CORP8_PASSWORD=
CORP8_HOST=
CORP8_RTSP_PORT=

# Firebase Authentication & Google Sign-In (Optional)
# In local development and demonstration mode, Sentinel operates seamlessly with built-in
# authorized officer credentials and simulation tokens.
# In production, provide Google Cloud / Firebase credentials:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud SQL (PostgreSQL) Runtime Configuration
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ==============================================================================
# Google Cloud Platform (GCP) Production Configuration
# Target Project: gujrat-cctv (Gujarat Police Sentinel)
# ==============================================================================
GOOGLE_CLOUD_PROJECT_ID=gujrat-cctv
GOOGLE_CLOUD_PROJECT=gujrat-cctv
GOOGLE_CLOUD_PROJECT_NUMBER=264410664731
GOOGLE_CLOUD_REGION=asia-south1
VERTEX_AI_LOCATION=asia-south1
VERTEX_AI_ENABLED=true
CLOUD_RUN_SERVICE_NAME=sentinel-command-center

# Pub/Sub Topics & Subscriptions (Zero Continuous Video)
PUBSUB_TOPIC_CAMERA_EVENTS=projects/gujrat-cctv/topics/sentinel-camera-events
PUBSUB_TOPIC_CAMERA_HEALTH=projects/gujrat-cctv/topics/sentinel-camera-health
PUBSUB_TOPIC_VEHICLE_OBSERVATIONS=projects/gujrat-cctv/topics/sentinel-vehicle-observations
PUBSUB_TOPIC_PLATE_OBSERVATIONS=projects/gujrat-cctv/topics/sentinel-plate-observations
PUBSUB_TOPIC_INCIDENTS=projects/gujrat-cctv/topics/sentinel-incidents
PUBSUB_TOPIC_ALERTS=projects/gujrat-cctv/topics/sentinel-alerts
PUBSUB_TOPIC_INVESTIGATION_EVENTS=projects/gujrat-cctv/topics/sentinel-investigation-events
PUBSUB_TOPIC_AI_ANALYSIS=projects/gujrat-cctv/topics/sentinel-ai-analysis
PUBSUB_TOPIC_EVIDENCE_EVENTS=projects/gujrat-cctv/topics/sentinel-evidence-events
PUBSUB_TOPIC_AUDIT_EVENTS=projects/gujrat-cctv/topics/sentinel-audit-events
PUBSUB_TOPIC_DEAD_LETTER=projects/gujrat-cctv/topics/sentinel-dlq

PUBSUB_SUBSCRIPTION_OBSERVATIONS=projects/gujrat-cctv/subscriptions/sentinel-poc-observations-sub
PUBSUB_SUBSCRIPTION_BIGQUERY=projects/gujrat-cctv/subscriptions/sentinel-poc-bigquery-sub

# BigQuery Datasets & Tables
BIGQUERY_DATASET_ANALYTICS=sentinel_poc
BIGQUERY_DATASET_SURVEILLANCE=sentinel_surveillance
BIGQUERY_TABLE_OBSERVATIONS=observations
BIGQUERY_TABLE_CAMERA_HEALTH=camera_health
BIGQUERY_TABLE_AUDIT_EVENTS=audit_events

# Cloud Storage (GCS) Evidence Vault (BSA 2023 Sec 63 7-Year Retention)
GCS_BUCKET_EVIDENCE=sentinel-evidence-gujrat-cctv
GCS_BUCKET_KEYFRAMES=sentinel-keyframes-gujrat-cctv
GCS_BUCKET_DERIVED=sentinel-derived-gujrat-cctv

# Google Application Credentials (ONLY for approved local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/local-service-account-key.json


